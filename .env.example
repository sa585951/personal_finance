# Flask / backend
FLASK_ENV=development
NOMICA_ENV=development
PORT=5000
FRONTEND_BASE_URL=http://localhost:5173
VITE_BACKEND_BASE_URL=http://localhost:5000
# Production: NOMICA_ENV=production, both origins must be the same HTTPS
# frontend origin; proxy /api and /line-login-* to the backend. See S1 docs.
DEV_AUTH_BYPASS=false

# Database
DATABASE_URL=postgresql://personal_finance:personal_finance@localhost:5433/personal_finance

# Auth
JWT_SECRET_KEY=replace-with-a-local-dev-secret

# LINE Login
LINE_LOGIN_CHANNEL_ID=replace-with-line-login-channel-id
LINE_LOGIN_CHANNEL_SECRET=replace-with-line-login-channel-secret

# LINE Messaging API
LINE_MSG_CHANNEL_ACCESS_TOKEN=replace-with-line-message-channel-access-token
LINE_MSG_CHANNEL_SECRET=replace-with-line-message-channel-secret

# Gemini
# LINE rules work without Gemini. LINE AI turns on with GEMINI_API_KEY and the
# paid-project confirmation below; it is capped at 5 USD a month by default.
# synthetic is loopback-only and uses local fallback, never the cloud model.
NOMICA_AI_MODE=disabled
# Omit to use the default bookkeeping mode. Set disabled to pause LINE replies.
NOMICA_LINE_MODE=oral_pilot
# Optional monthly cap in USD (empty = 5, "0" = LINE AI off).
NOMICA_LINE_AI_MONTHLY_USD=
# Set true only after confirming GEMINI_API_KEY belongs to a paid Gemini project,
# so users' bookkeeping text is not used to improve Google products.
NOMICA_LINE_AI_PAID_PROJECT_VERIFIED=false
# Optional per-person AI requests per day (Taipei time; empty = 30; invalid = AI off).
NOMICA_LINE_AI_DAILY_PER_USER=
# Optional: your LINE user ID (LINE Developers > channel > Basic settings > Your user ID).
# Receives one LINE message a month when AI spending reaches 80% of the monthly cap, and the
# account linked to this LINE ID sees the usage overview under 我的 (counts only, no financial content).
NOMICA_ADMIN_LINE_USER_ID=
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite
